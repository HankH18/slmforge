# Grounded Abstainer — required environment
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Frontier teacher + ablation family A (P1, P2, P3)
OPENAI_API_KEY=

# Frontier ablation family B (P1, P2)
GOOGLE_API_KEY=

# LLM-as-judge — third family, never scores itself (P1..P6)
ANTHROPIC_API_KEY=

# Hugging Face — token needs WRITE scope to publish the tuned model (P5)
HF_TOKEN=
HF_USERNAME=

# Optional: override the pinned judge model (default claude-sonnet-4-6)
# JUDGE_MODEL=
